    {
      "id": "li-mortacci-tua",
      "original": "li mortacci tua",
      "variants": [
        "mortacci tua",
        "'tacci tua",
        "li mortacci vostra",
        "li mortacci sua",
        "li mortacci mia"
      ],
      "category": "imprecation",
      "literal_meaning": "i tuoi morti (peggiorativo)",
      "meaning_it": "(lett. i tuoi morti schifosi) insulto ai defunti dell'interlocutore; per estensione esclamazione di rabbia, stupore o affetto",
      "meaning_en": "(lit. your lousy dead) insult to someone's dead relatives; by extension an exclamation of anger, amazement or affection",
      "intensity": 4,
      "register": "vulgar",
      "usage": {
        "friendly": true,
        "hostile": true,
        "emotional": [
          "anger",
          "surprise",
          "affection"
        ]
      },
      "appropriate_contexts": [
        "joyful surprise among friends",
        "venting at a bug"
      ],
      "inappropriate_contexts": [
        "formal",
        "people in mourning"
      ],
      "blasphemy": false,
      "generation_allowed": true,
      "examples": [
        {
          "text": "Li mortacci tua, quanto tempo!",
          "provenance": "ai-illustrative",
          "translation_it": "Accidenti, quanto tempo!",
          "translation_en": "Damn, long time no see!"
        }
      ],
      "geographical_area": "Rome (Romanesco)",
      "sources": [
        "src-rom-itwiki-dialetto",
        "src-rom-wiktionary",
        "src-rom-intrepidguide",
        "src-rom-elon"
      ],
      "provenance": "attested",
      "verification_status": "source-checked",
      "notes": "Tone decides meaning (itwiki). Hostile when aimed at someone in anger."
    },
