  "$schema": "../../../../../schemas/profanity.schema.json",
  "dialect": "socmel",
  "entries": [
    {
      "id": "socc-mel",
      "original": "sòcc'mel",
      "category": "exclamation",
      "literal_meaning": "succhiamelo",
      "meaning_it": "Intercalare bolognese per eccellenza: stupore, ammirazione, disappunto, derisione, a volte affetto. Il senso letterale (invito sessuale volgare) è molto sbiadito.",
      "meaning_en": "The quintessential Bolognese exclamation (surprise, admiration, annoyance, mockery, sometimes affection); the literal crude sense has faded.",
      "intensity": 3,
      "register": "vulgar",
      "usage": {
        "friendly": true,
        "hostile": true,
        "emotional": [
          "surprise",
          "admiration",
          "annoyance",
          "affection"
        ]
      },
      "blasphemy": false,
      "generation_allowed": true,
      "geographical_area": "Bologna",
      "sources": [
        "src-bo-itwiki-soccmel",
        "src-bo-itwiki-dialetto",
        "src-bo-socmel-it",
        "src-bo-bulgnais-lessico",
        "src-bo-slengo-socmel"
      ],
      "provenance": "attested",
      "verification_status": "source-checked",
      "examples": [
        {
          "text": "Socmel che noia!",
          "translation_it": "Accidenti che noia!",
          "provenance": "unverified"
        },
        {
          "text": "Sòcc'mel, l é andè mèl!",
          "translation_it": "Accidenti, è andata male!",
          "provenance": "ai-illustrative"
        }
      ],
      "notes": "Mode identifier. Said by young and old (Wikipedia). Lengthened 'sooocmel' and the texting abbreviation 'SCM' are mentioned by socmel.it (low reliability). Menarini: 'shibboleth' of Bologna.",
      "variants": [
        "sòccmel",
        "sócc'mel",
        "socc'mel",
        "socmel",
        "soccmel"
      ],
      "appropriate_contexts": [
        "bugs, rain, queues, good food, surprising news",
        "among friends"
      ],
      "inappropriate_contexts": [
        "formal writing, official contexts, with strangers or elders unless clearly joking"
      ]
    },
