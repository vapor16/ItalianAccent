{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vapor16/ItalianAccent/schemas/lexicon.schema.json",
  "title": "ItalianAccent lexicon (vocabulary, interjections, colloquial expressions)",
  "type": "object",
  "required": [
    "dialect",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "dialect": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "term",
          "category",
          "meaning_it",
          "meaning_en",
          "register",
          "provenance",
          "verification_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "term": {
            "type": "string",
            "minLength": 1
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "category": {
            "type": "string",
            "enum": [
              "word",
              "interjection",
              "colloquial-expression",
              "function-word",
              "greeting",
              "address-term"
            ]
          },
          "part_of_speech": {
            "type": "string"
          },
          "meaning_it": {
            "type": "string",
            "minLength": 1
          },
          "meaning_en": {
            "type": "string",
            "minLength": 1
          },
          "register": {
            "type": "string",
            "enum": [
              "neutral",
              "colloquial",
              "familiar",
              "popular",
              "vulgar",
              "very-vulgar",
              "affectionate",
              "ironic",
              "archaic",
              "formal"
            ]
          },
          "vulgarity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "contexts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "translation_it": {
                  "type": "string"
                },
                "translation_en": {
                  "type": "string"
                },
                "provenance": {
                  "type": "string",
                  "enum": [
                    "attested",
                    "documented-rule",
                    "ai-illustrative",
                    "unverified",
                    "community",
                    "native-reviewed"
                  ]
                }
              }
            }
          },
          "geographical_area": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^src-[a-z0-9-]+$"
            },
            "uniqueItems": true
          },
          "provenance": {
            "type": "string",
            "enum": [
              "attested",
              "documented-rule",
              "ai-illustrative",
              "unverified",
              "community",
              "native-reviewed"
            ]
          },
          "verification_status": {
            "type": "string",
            "enum": [
              "unverified",
              "source-checked",
              "community-reviewed",
              "native-reviewed"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}