{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vapor16/ItalianAccent/schemas/sources.schema.json",
  "title": "ItalianAccent source registry",
  "type": "object",
  "required": [
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "url",
          "access_date",
          "linguistic_area",
          "source_type",
          "license",
          "redistribution",
          "reliability"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^src-[a-z0-9-]+$"
          },
          "title": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "publication_date": {
            "type": "string"
          },
          "access_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "linguistic_area": {
            "type": "string"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "academic",
              "institutional",
              "historical-dictionary",
              "public-domain",
              "openly-licensed",
              "community-dictionary",
              "native-speaker",
              "popular-web",
              "encyclopedia",
              "literature"
            ]
          },
          "license": {
            "type": "string"
          },
          "redistribution": {
            "type": "string",
            "enum": [
              "public-domain",
              "open-license-attribution",
              "facts-only-citation",
              "not-permitted"
            ]
          },
          "reliability": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "reliability_notes": {
            "type": "string"
          },
          "relevant_sections": {
            "type": "string"
          },
          "used_by": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}